prefix ilxtr: <http://uri.interlex.org/tgbugs/uris/readable/>
prefix neurdf.ent: <http://uri.interlex.org/tgbugs/uris/readable/neurdf/pred/ent/>
prefix neurdf.eqv: <http://uri.interlex.org/tgbugs/uris/readable/neurdf/pred/eqv/>
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix UBERON: <http://purl.obolibrary.org/obo/UBERON_>

CONSTRUCT
{
    ?Neuron_Connected ilxtr:hasCandidateCellType ?Cell_Type .

    << ?Neuron_Connected ilxtr:hasCandidateCellType ?Cell_Type >>
        ilxtr:hasSomaLocation     ?Origin_IRI ;
        ilxtr:hasAxonType         ?Axon_Type_IRI ;
        ilxtr:hasCircuitRole      ?Circuit_Role_IRI ;
        ilxtr:isObservedInSpecies ?Species_IRI ;
        ilxtr:hasFunction         ?Functional_Phenotype_IRI ;
        ilxtr:hasThreshold        ?Threshold_Phenotype_IRI ;
        ilxtr:hasCircuitMembership ?Neural_Circuit_IRI .
}
WHERE
{
    # ---- Parameters ---------------------------------------------------------
    VALUES ?sckan_neuron     { ilxtr:NeuronComposer ilxtr:NeuronApinatComplex }
    VALUES ?Origin_Structure { UBERON:0000044 UBERON:0001675 }   # DRG/TG and subclasses
    VALUES ?Circuit_Role_IRI { ilxtr:SensoryPhenotype }

    # ---- 1) The neuron ------------------------------------------------------
    ?Neuron_Connected rdfs:subClassOf+ ?sckan_neuron .

    << ?Neuron_Connected ilxtr:hasSomaLocation ?Soma_ID >> ilxtr:hasRegion ?Origin_IRI .
    ?Origin_IRI rdfs:subClassOf* ?Origin_Structure .

    ?Neuron_Connected ilxtr:hasAxonType    ?Axon_Type_IRI ;
                      ilxtr:hasCircuitRole ?Circuit_Role_IRI .

    OPTIONAL { ?Neuron_Connected ilxtr:isObservedInSpecies ?Species_IRI . }

    # ---- 2) The cell type: common soma, axon type and circuit role ----------
    ?Cell_Type rdfs:subClassOf+ ilxtr:NeuronPrecision ;
               neurdf.eqv:hasSomaLocatedIn        ?Origin_IRI ;
               neurdf.eqv:hasAxonPhenotype        ?Axon_Type_IRI ;
               neurdf.ent:hasCircuitRolePhenotype ?Circuit_Role_IRI ;
               neurdf.ent:hasInstanceInTaxon      ?Species_IRI .

    # ---- 3) Optional extras (must be on both neuron and cell type) ----------
    OPTIONAL {
        ?Neuron_Connected ilxtr:hasFunction ?Functional_Phenotype_IRI .
        ?Cell_Type neurdf.eqv:hasFunctionalPhenotype ?Functional_Phenotype_IRI .
    }
    OPTIONAL {
        ?Neuron_Connected ilxtr:hasThreshold ?Threshold_Phenotype_IRI .
        ?Cell_Type neurdf.eqv:hasThresholdPhenotype ?Threshold_Phenotype_IRI .
    }
    OPTIONAL {
        ?Neuron_Connected ilxtr:hasCircuitMembership ?Neural_Circuit_IRI .
        ?Cell_Type neurdf.ent:isMemberOfCircuit ?Neural_Circuit_IRI .
    }
}