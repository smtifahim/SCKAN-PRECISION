femrep:30 a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf (
                    ilxtr:NeuronSparcNlp
                    [ a owl:Restriction ;
                        owl:onProperty ilxtr:hasAxonLocatedIn ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty partOf: ;
                                owl:someValuesFrom ILX:0794916 ] ]
                    [ a owl:Restriction ;
                        owl:onProperty ilxtr:hasAxonPresynapticElementIn ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty partOf: ;
                                owl:someValuesFrom ILX:0739295 ] ]
                    [ a owl:Restriction ;
                        owl:onProperty ilxtr:hasAxonPresynapticElementIn ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty partOf: ;
                                owl:someValuesFrom ILX:0787009 ] ]
                    [ a owl:Restriction ;
                        owl:onProperty ilxtr:hasAxonPresynapticElementIn ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty partOf: ;
                                owl:someValuesFrom ILX:0789862 ] ]
                    [ a owl:Restriction ;
                        owl:onProperty ilxtr:hasBiologicalSex ;
                        owl:someValuesFrom PATO:0000383 ]
                    [ a owl:Restriction ;
                        owl:onProperty ilxtr:hasForwardConnectionPhenotype ;
                        owl:someValuesFrom femrep:31 ]
                    [ a owl:Restriction ;
                        owl:onProperty ilxtr:hasForwardConnectionPhenotype ;
                        owl:someValuesFrom femrep:32 ]
                    [ a owl:Restriction ;
                        owl:onProperty ilxtr:hasForwardConnectionPhenotype ;
                        owl:someValuesFrom femrep:33 ]
                    [ a owl:Restriction ;
                        owl:onProperty ilxtr:hasSomaLocatedIn ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty partOf: ;
                                owl:someValuesFrom UBERON:0007715 ] ]
                    [ a owl:Restriction ;
                        owl:onProperty ilxtr:hasSomaLocatedIn ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty partOf: ;
                                owl:someValuesFrom UBERON:0007716 ] ] ) ] ;
    rdfs:label "neuron type femrep 30" ;
    skos:prefLabel "T1-L2 spinal cord to paravertebral sympathetic chain of T12-L1 via white rami communicantes" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ilxtr:hasAnatomicalSystemPhenotype ;
            owl:someValuesFrom ilxtr:neuron-phenotype-sym-pre ],
        [ a owl:Restriction ;
            owl:onProperty ilxtr:hasCircuitRolePhenotype ;
            owl:someValuesFrom ilxtr:ProjectionPhenotype ],
        [ a owl:Restriction ;
            owl:onProperty ilxtr:hasInstanceInTaxon ;
            owl:someValuesFrom NCBITaxon:10116 ] ;
    ilxcr:hasComposerURI <https://composer.scicrunch.io/statement/252> ;
    ilxtr:alertNote """Connectivity ambiguity: In the absence of experimental data on the specific spinal cord level from which this connection arises we decided to include all sympathetic spinal cord levels from T1 to L2. 
Spatial extent: Houdeau (1998) using retrograde tracing shows that the epicenter of the origin of the postganglionic fibers in the paravertebral sympathetic chain is at T12-L1, but the spread ranges from T10 to L2.
Physiological condition: Sympathetic innervation is known to undergo dynamic functional and/or anatomical changes during gestation. This has been observed in several species including rats and humans. Vera et al (1997) https://doi.org/10.1016/s0006-8993(96)01107-9.""" ;
    ilxtr:curatorNote "Wulf (2023) https://doi.org/10.3389/fncel.2023.999253 mentioned about the sympathetic innervation “The SPNs reside in the intermediolateral cell column (IML) of thoracolumbar spinal cord segments T1-L2 (McLachlan and Oldfield, 1981; Oldfield and McLachlan, 1981; Anderson et al., 1989)”. In light of the absense of experimental data on the level of the spinal cord that this connection arises from and suggested by the knowledge expert we decided to include all the sympathetic spinal cord from T1-L2. Houdeau (1998) using retrograde tracing shows that the epicenter of the origin of the postganglionic fibers in the paravertebral sympathetic chain is at T12-L1, but the spread ranges from T10 to L2. Alert 1 was suggested by the knowledge domain expert." ;
    ilxtr:genLabel "female lumbar subsegment of spinal cord thoracic subsegment of spinal cord (with-axon-in white ramus communicans) (with-axon-presynaptic-element-in L1 sympathetic chain ganglion T12 sympathetic chain ganglion T13 sympathetic chain ganglion) (projecting-onto neuron type femrep 31 neuron type femrep 32 neuron type femrep 33) (implies Rattus norvegicus Sympathetic Pre-Ganglionic projection) neuron (sprcnlp)" ;
    ilxtr:literatureCitation <https://doi.org/10.1002/(SICI)1096-9861(19980928)399:3%3C403::AID-CNE8%3E3.0.CO;2-4>,
        <https://doi.org/10.1016/j.autneu.2014.11.009> ;
    ilxtr:neuronPartialOrder (
            "blank"
            (
                UBERON:0007715
                (
                    ILX:0794916
                    (
                        ILX:0739295 )
                    (
                        ILX:0787009 )
                    (
                        ILX:0789862 ) ) )
            (
                UBERON:0007716
                (
                    ILX:0794916 ) ) ) .

