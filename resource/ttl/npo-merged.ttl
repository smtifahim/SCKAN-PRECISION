            owl:onProperty ilxtr:hasInstanceInTaxon ;
            owl:someValuesFrom NCBITaxon:10116 ] ;
    ilxcr:hasComposerURI <https://composer.scicrunch.io/statement/528> ;
    ilxtr:curatorNote "We split this population and the population \"nodose ganglion with axon sensory terminal in the myenteric ganglia of the stomach via vagus nerve (via intraganglionic Laminar Endings) with axon terminal in nucleus of the tractus solitarius via vagus nerve\" because based on the references we interpret that these are two different kinds of vagal afferent fibers travelling from the nodose ganglion to the stomach." ;
