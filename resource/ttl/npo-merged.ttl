    skos:prefLabel "T10-L1 spinal cord to pelvic ganglion via superior hypogastric plexus via hypogastric nerve via inferior hypogastric plexus" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ilxtr:hasAnatomicalSystemPhenotype ;
            owl:someValuesFrom ilxtr:neuron-phenotype-sym-pre ],
