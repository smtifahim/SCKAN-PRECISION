MMRRC:030648 a owl:Class ;
    rdfs:label "Ntsr1-Cre_GN220" ;
    definition: "Specific to cortical layer 6 neurons." ;
    rdfs:subClassOf ilxtr:transgenicLine ;
    ilxtr:hasTransgenicType ilxtr:driverLine .

MMRRC:031125 a owl:Class ;
    rdfs:label "Rbp4-Cre_KL100" ;
    definition: "Enriched in cortical layer 5 and the dentate gyrus." ;
    rdfs:subClassOf ilxtr:transgenicLine ;
    ilxtr:hasTransgenicType ilxtr:driverLine .

MMRRC:031181 a owl:Class ;
    rdfs:label "Gng7-Cre_KH71" ;
    definition: "Enriched in striatum and neocortical layers 2 and 5, and in restricted populations within the medulla, pons, midbrain, hippocampus, hypothalamus, thalamus, and olfactory areas." ;
    rdfs:subClassOf ilxtr:transgenicLine ;
    ilxtr:hasTransgenicType ilxtr:driverLine .

MMRRC:031742 a owl:Class ;
    rdfs:label "Sim1-Cre_KJ18" ;
    definition: "Enriched in restricted populations within layer 5 of cortex, striatum (amygdala), and hypothalamus. Sparse, scattered expression elsewhere in the brain." ;
    rdfs:subClassOf ilxtr:transgenicLine ;
    ilxtr:hasTransgenicType ilxtr:driverLine .

MMRRC:032779 a owl:Class ;
    rdfs:label "Cux2-CreERT2" ;
    definition: "Enriched in cortical layers 2/3/4, thalamus, midbrain, pons, medulla and cerebellum. " ;
    rdfs:subClassOf ilxtr:transgenicLine ;
    ilxtr:hasTransgenicType ilxtr:inducibleDriverLine .

MMRRC:036502 a owl:Class ;
    rdfs:label "Chrna2-Cre_OE25" ;
    definition: "Enriched in cortical layer 5. Also expressed in restricted populations throughout the brain, including olfactory areas, hippocampus, lateral septal complex, pallidum, thalamus, hypothalamus, midbrain, hindbrain, and cerebellum." ;
    rdfs:subClassOf ilxtr:transgenicLine ;
    ilxtr:hasTransgenicType ilxtr:driverLine .

MMRRC:036504 a owl:Class ;
    rdfs:label "Glt25d2-Cre_NF107" ;
    definition: "Reporter expression displays laminar enrichment in rostral cortex and in restricted populations within cortical subplate." ;
    rdfs:subClassOf ilxtr:transgenicLine ;
