    rdfs:label "neuron type kidney 132" ;
    skos:prefLabel "aorticorenal ganglion to tunica adventitia of the renal artery OR afferent/efferent arterioles OR the juxtaglomerular apparatus OR renal tubules OR upper ureter via renal nerve plexus" ;
