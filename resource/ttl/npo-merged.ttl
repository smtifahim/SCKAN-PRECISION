    skos:prefLabel "nodose ganglion with axon sensory terminal in the circular or longitudinal muscle layer of the stomach or myenteric ganglia of the stomach via vagus nerve (via intramuscular arrays) with axon terminal in nucleus of the tractus solitarius via root of vagus nerve" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ilxtr:hasCircuitRolePhenotype ;
            owl:someValuesFrom ilxtr:ProjectionPhenotype ],
        [ a owl:Restriction ;
            owl:onProperty ilxtr:hasCircuitRolePhenotype ;
